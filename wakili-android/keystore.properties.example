# Release signing. Copy to keystore.properties (gitignored) and fill in.
# Generate the keystore once — from wakili-android/, run:
#   keytool -genkeypair -v -keystore release.jks -alias wakili \
#     -keyalg RSA -keysize 2048 -validity 10000
# (keytool lives in the JDK: "C:\Program Files\Android\Android Studio2\jbr\bin\keytool.exe")
# KEEP release.jks AND these passwords safe — updates must be signed with the
# same key forever; losing it means users reinstall from scratch.
storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=wakili
keyPassword=CHANGE_ME
